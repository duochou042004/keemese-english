# Normalize to LF in the repo and in working copies on every OS (see docs/operations/local-setup.md).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.mp3  binary
*.m4a  binary
*.wav  binary
*.mp4  binary
*.woff binary
*.woff2 binary
