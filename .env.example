POSTGRES_PASSWORD=change-me-local-only
ConnectionStrings__Db=Host=localhost;Port=5432;Database=keemese;Username=keemese;Password=change-me-local-only
DATA_DIR=./.data
BOOTSTRAP_TUTOR_USERNAME=tutor
BOOTSTRAP_TUTOR_PASSWORD=change-me-on-first-login
# Replace with a random 32+ character value before running the app container (--profile app, E2E): outside Development the app refuses change-me placeholders.
Security__IpHashSalt=change-me-random-string
APP_NAME=Keemese
# Reverse proxy addresses allowed to send X-Forwarded-For/-Proto (comma-separated). Empty = trust nobody.
ForwardedHeaders__KnownProxies=
ForwardedHeaders__KnownNetworks=
